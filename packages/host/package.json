{
  "name": "dsh-ollama-web",
  "version": "2.3.0",
  "description": "Ollama Cloud web search provider for DeepSeek Harness, with a Web UI settings card and update checks and installs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": ">=20.3.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-web": ">=0.2.1-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-web": "0.2.1-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && node ../../scripts/check-dist.mjs && node ../../scripts/check-client.mjs",
    "test:e2e": "node --test test/e2e/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ollama",
    "web-search"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/explorrrr/dsh-ollama-web.git"
  },
  "homepage": "https://github.com/explorrrr/dsh-ollama-web#readme",
  "bugs": {
    "url": "https://github.com/explorrrr/dsh-ollama-web/issues"
  }
}
